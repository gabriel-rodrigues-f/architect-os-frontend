# URL do backend. Copie para .env (ou .env.local) se mudar a porta do compose.
VITE_API_URL=http://localhost:4000

# R1-P05 (SYNAPSE-DIRECIONAMENTO-EXECUCAO.md, completa B-27) — mesmo DSN do
# GlitchTip usado pelo backend (ver backend/.env.example). Vazio = captura
# de erro desligada dos dois lados do frontend (SSR e navegador).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Endereço do Grafana, que o menu abre. Vazio -> a porta da API
# (`<VITE_API_URL>/grafana/`), que confere a sessão do administrador e entra no
# Grafana sem senha; noutra topologia (um Ingress servindo /grafana na mesma
# origem), declare o caminho aqui.
VITE_GRAFANA_URL=
